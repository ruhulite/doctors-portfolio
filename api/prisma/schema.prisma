generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum VideoSource {
  UPLOAD
  YOUTUBE
  FACEBOOK
  EXTERNAL
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LandingSection {
  id               String   @id @default(cuid())
  key              String   @unique
  title            String
  enabled          Boolean  @default(true)
  sortOrder        Int      @default(0)
  draftContent     Json
  publishedContent Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Video {
  id              String        @id @default(cuid())
  source          VideoSource
  titleBn         String
  titleEn         String
  descriptionBn   String        @default("")
  descriptionEn   String        @default("")
  categoryBn      String        @default("স্বাস্থ্য সচেতনতা")
  categoryEn      String        @default("Health Awareness")
  mediaUrl        String
  thumbnailUrl    String?
  captionsUrl     String?
  durationSeconds Int?
  status          PublishStatus @default(DRAFT)
  featured        Boolean       @default(false)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
